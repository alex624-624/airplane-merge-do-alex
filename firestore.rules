rules_version = '2';

// Regras do banco do Airplane Merge do Alex.
// Cole este arquivo em: Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function mine(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // O nome gravado tem que ser o nome da própria conta
    // (o domínio é o mesmo de docs/js/backend-firebase.js).
    function nameOk(d) {
      return d.name is string
        && d.name.matches('^[A-Za-z0-9_-]{3,16}$')
        && request.auth.token.email == d.name.lower() + '@pilotos.example.com';
    }

    // Progresso: só o dono lê e grava.
    match /saves/{uid} {
      allow get, delete: if mine(uid);
      allow create, update: if mine(uid)
        && request.resource.data.keys().hasAll(['name', 'save', 'sess', 'at'])
        && request.resource.data.keys().hasOnly(['name', 'save', 'sess', 'at'])
        && nameOk(request.resource.data)
        && request.resource.data.save is string
        && request.resource.data.save.size() <= 6000
        && request.resource.data.sess is string
        && request.resource.data.sess.size() <= 40
        && request.resource.data.at is number
        && request.resource.data.at >= 0;
    }

    // Ranking: qualquer jogador logado lê; cada um só grava a própria linha.
    match /ranking/{uid} {
      allow get, list: if signedIn();
      allow delete: if mine(uid);
      allow create, update: if mine(uid)
        && request.resource.data.keys().hasAll(['name', 'best', 'total', 'score'])
        && request.resource.data.keys().hasOnly(['name', 'best', 'total', 'score'])
        && nameOk(request.resource.data)
        && request.resource.data.best is int
        && request.resource.data.best >= 1
        && request.resource.data.best <= 40
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.score is number
        && request.resource.data.score >= request.resource.data.best
        && request.resource.data.score < request.resource.data.best + 1;
    }
  }
}
